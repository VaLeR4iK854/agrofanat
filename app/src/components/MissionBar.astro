---
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const link = (hash: string) => (isHome ? `#${hash}` : `/#${hash}`);
---

<header class="fixed top-0 left-0 right-0 z-50 backdrop-blur-md bg-bg/70 border-b border-border">
  <div class="mx-auto max-w-[1400px] px-6 lg:px-10 h-12 flex items-center justify-between text-[11px] font-mono uppercase tracking-[0.18em]">
    <a href="/" class="flex items-center gap-3 group">
      <span class="signal-dot"></span>
      <span class="text-text group-hover:text-accent transition-colors">АГРОФАНАТ</span>
    </a>

    <nav class="hidden md:flex items-center gap-8 text-text-dim">
      <a href={link("manifesto")} class="hover:text-text transition-colors">Манифест</a>
      <a href={link("protocols")} class="hover:text-text transition-colors">Рубрики</a>
      <a href={link("roadmap")} class="hover:text-text transition-colors">План</a>
      <a href={link("channels")} class="hover:text-text transition-colors">Платформы</a>
    </nav>

    <a
      href={link("subscribe")}
      class="md:hidden inline-flex items-center gap-2 text-accent hover:text-signal transition-colors"
    >
      <span class="signal-dot !w-[4px] !h-[4px]"></span>
      Подписка
    </a>

    <div class="hidden md:flex items-center gap-3 text-text-dim">
      <span class="hidden sm:inline">СЕЗОН</span>
      <span class="text-text tabular-nums">2026</span>
    </div>
  </div>
</header>
