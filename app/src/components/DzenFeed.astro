---
import feed from "../data/dzen-posts.json";

const posts = feed.posts.slice(0, 3);

const dateFormatter = new Intl.DateTimeFormat("ru-RU", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});

function formatDate(iso: string | null) {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  return dateFormatter.format(d).replace(/\.$/, "").toUpperCase();
}
---

{posts.length > 0 && (
  <section class="relative py-24 lg:py-32 border-t border-border">
    <div class="mx-auto max-w-[1400px] px-6 lg:px-10">

      <div class="flex items-end justify-between mb-16 lg:mb-20 reveal">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="h-px w-10 bg-accent/60"></div>
            <span class="label-accent">06 / СВЕЖИЕ ЗАПИСИ</span>
          </div>
          <h2 class="display text-[40px] lg:text-[64px] text-text">Из дневника</h2>
        </div>
        <a
          href={feed.channel.url}
          rel="me noopener"
          target="_blank"
          class="hidden md:inline-flex items-center gap-2 label hover:text-accent transition-colors group"
        >
          ВСЕ ЗАПИСИ В ДЗЕНЕ
          <span class="transition-transform group-hover:translate-x-1">→</span>
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-px bg-border">
        {posts.map((p, i) => {
          const code = `№ ${String(i + 1).padStart(2, "0")}`;
          const date = formatDate(p.publishedAt);
          return (
            <a
              href={p.url}
              rel="me noopener"
              target="_blank"
              class="group relative bg-bg overflow-hidden hover:bg-bg-elevated transition-colors reveal flex flex-col"
              style={`--reveal-delay: ${i * 100}ms`}
            >
              <div class="relative aspect-[16/10] bg-gradient-to-br from-accent/15 to-transparent border-b border-border overflow-hidden">
                {p.image ? (
                  <img
                    src={p.image}
                    alt={p.title}
                    loading="lazy"
                    decoding="async"
                    referrerpolicy="no-referrer"
                    class="absolute inset-0 w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-[1.02] transition-all duration-500"
                  />
                ) : (
                  <>
                    <div class="absolute inset-0 grid-bg opacity-40"></div>
                    <div class="absolute inset-0 flex items-center justify-center">
                      <div class="font-mono text-[10px] tracking-[0.2em] uppercase text-text-muted">
                        ◌ ◌ ◌
                      </div>
                    </div>
                  </>
                )}

                <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
                  <span class="label-accent bg-bg/70 backdrop-blur px-2 py-1">{code}</span>
                  <span class="font-mono text-[11px] text-text bg-bg/80 backdrop-blur px-2 py-1 tabular-nums">{p.readingMinutes} МИН</span>
                </div>

                <div class="absolute bottom-4 left-4">
                  <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-bg bg-accent px-2 py-1">ДЗЕН</span>
                </div>
              </div>

              <div class="p-6 lg:p-8 flex-1 flex flex-col">
                {date && <div class="font-mono text-[11px] tracking-[0.18em] uppercase text-text-muted mb-3 tabular-nums">{date}</div>}
                <h3 class="display text-[24px] lg:text-[28px] text-text mb-3 leading-[1.1] group-hover:text-accent transition-colors">
                  {p.title}
                </h3>
                <p class="text-[14px] leading-[1.5] text-text-dim line-clamp-3 mb-6">{p.description}</p>
                <span class="mt-auto inline-flex items-center gap-2 font-mono text-[11px] tracking-[0.18em] uppercase text-accent group-hover:translate-x-1 transition-transform">
                  Открыть в Дзене <span>↗</span>
                </span>
              </div>
            </a>
          );
        })}
      </div>

      <div class="mt-12 flex items-center justify-between gap-6 reveal">
        <p class="font-mono text-[12px] tracking-[0.1em] uppercase text-text-muted hidden sm:block">
          ⌁ Свежий протокол - каждую неделю
        </p>
        <a
          href={feed.channel.url}
          rel="me noopener"
          target="_blank"
          class="group inline-flex items-center gap-3 px-6 h-12 font-mono text-[12px] tracking-[0.18em] uppercase text-text border border-border-strong hover:border-accent hover:text-accent transition-colors"
        >
          Все записи в Дзене
          <span class="transition-transform group-hover:translate-x-1">↗</span>
        </a>
      </div>

    </div>
  </section>
)}
