---
const channels = [
  {
    code: "№ 01",
    name: "Дзен",
    handle: "Агрофанат",
    desc: "Текстовые версии экспериментов, фото, расчёты",
    status: "В ЭФИРЕ",
    href: "https://dzen.ru/id/5d597768a2d6ed00ac2cd607",
    live: true,
  },
  {
    code: "№ 02",
    name: "Ютуб",
    handle: "скоро",
    desc: "Длинные эксперименты, сборки, разборы",
    status: "СКОРО",
    href: null,
    live: false,
  },
  {
    code: "№ 03",
    name: "Телеграм",
    handle: "скоро",
    desc: "Ежедневный дневник, чертежи, ответы",
    status: "СКОРО",
    href: null,
    live: false,
  },
  {
    code: "№ 04",
    name: "ТикТок",
    handle: "скоро",
    desc: "Короткие лайфхаки, результаты",
    status: "СКОРО",
    href: null,
    live: false,
  },
];
---

<section id="channels" class="relative py-24 lg:py-32 border-t border-border">

  <div class="mx-auto max-w-[1400px] px-6 lg:px-10">

    <div class="flex items-end justify-between mb-16 lg:mb-20 reveal">
      <div>
        <div class="flex items-center gap-3 mb-4">
          <div class="h-px w-10 bg-accent/60"></div>
          <span class="label-accent">06 / ПЛАТФОРМЫ</span>
        </div>
        <h2 class="display text-[40px] lg:text-[64px] text-text">
          Где смотреть<span class="text-accent">.</span>
        </h2>
      </div>
      <span class="hidden md:inline label">1 В ЭФИРЕ · 3 НА СТАРТЕ</span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-px bg-border">
      {channels.map((ch, i) => {
        const Inner = (
          <>
            <div class="flex items-start justify-between mb-12">
              <div class="flex items-center gap-3">
                <span class={`signal-dot ${ch.live ? "" : "opacity-30"}`}></span>
                <span class="label-accent">{ch.code}</span>
              </div>
              <div class="flex items-center gap-2">
                <span class={`font-mono text-[10px] tracking-[0.2em] uppercase ${ch.live ? "text-accent" : "text-text-muted"}`}>{ch.status}</span>
              </div>
            </div>

            <div class="flex items-end justify-between">
              <div>
                <h3 class={`display text-[44px] lg:text-[56px] mb-2 transition-colors ${ch.live ? "text-text group-hover:text-accent" : "text-text-dim"}`}>
                  {ch.name}
                </h3>
                <p class="font-mono text-[13px] text-text-dim mb-3">{ch.handle}</p>
                <p class="text-[14px] text-text-dim max-w-[36ch]">{ch.desc}</p>
              </div>
              {ch.live && (
                <span class="font-mono text-[24px] text-text-muted group-hover:text-accent group-hover:translate-x-1 transition-all">↗</span>
              )}
            </div>
          </>
        );

        return ch.href ? (
          <a
            href={ch.href}
            rel="me noopener"
            target="_blank"
            class="group relative bg-bg p-8 lg:p-10 hover:bg-bg-elevated transition-colors reveal"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            {Inner}
          </a>
        ) : (
          <div
            class="group relative bg-bg p-8 lg:p-10 reveal"
            style={`--reveal-delay: ${i * 80}ms`}
          >
            {Inner}
          </div>
        );
      })}
    </div>

  </div>
</section>
